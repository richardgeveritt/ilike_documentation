ilike 1.0
// a linear-Gaussian state-space model whose transition depends on a parameter a

model {
  x ~ norm(0, 1)
  transition x = linear_gaussian(matrix = cpp::transition_matrix, covariance = 0.5)
  factor obs = linear_gaussian(data = y, state = x, matrix = 1, covariance = 1)
  time = ssm(index = i, first_index = 0, last_index = 4, time = t, initial_time = 0,
             time_difference = dt, time_step = 1, predictions_per_update = 1)
}

cpp {
arma::mat transition_matrix(const Parameters &parameters)
{
  arma::mat A(1, 1);
  A(0, 0) = parameters["a"][0];
  return A;
}
}

algorithm filter {
  particles = 500
}

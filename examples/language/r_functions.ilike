ilike 1.0
// the same model, with the functions written in R

data {
  x = r::c(1.3, 0.2, 0.9)
}

model {
  prior p = density(log = r::dnorm(theta, 0, 10, log = TRUE),
                    simulate = r::list(theta = rnorm(1, 0, 10)))
  factor lik = r::log_likelihood(theta, x)
}

r {
log_likelihood = function(theta, x) sum(dnorm(x, theta, 1, log = TRUE))
}

algorithm mcmc {
  move m = metropolis(norm_rw(theta, 1))
  termination = iterations(10000)
}

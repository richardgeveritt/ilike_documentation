// Unknown mean θ of Gaussian data with known standard deviation 1:
// θ ~ N(0, 10^2), y_i | θ ~ N(θ, 1), i = 1, ..., 100.
// The data are the "gaussian" data set from the ilike package, loaded by the
// R function get_data() in gaussian_model.R (sourced automatically, since it
// has the same name as this file).

double prior_mean = 0.0;
double prior_sd = 10.0;

/***data,y=get_data()***/

/***evaluate_log_prior***/
double log_prior(const Parameters &parameters)
{
  return dnorm(parameters["θ"][0], prior_mean, prior_sd);
}

/***simulate_prior***/
Parameters simulate_prior(RandomNumberGenerator &rng)
{
  return Parameters("θ", rnorm(rng, prior_mean, prior_sd));
}

/***evaluate_gradient_log_prior***/
arma::mat gradient_log_prior(const std::string &variable,
                             const Parameters &parameters)
{
  arma::mat gradient(1, 1);
  gradient(0, 0) = -(parameters["θ"][0] - prior_mean)/(prior_sd*prior_sd);
  return gradient;
}

/***evaluate_log_likelihood***/
double log_likelihood(const Parameters &parameters,
                      const Data &data)
{
  arma::colvec y = data["y"];
  double result = 0.0;
  for (size_t i = 0; i < y.n_elem; ++i)
    result = result + dnorm(y[i], parameters["θ"][0], 1.0);
  return result;
}

/***evaluate_gradient_log_likelihood***/
arma::mat gradient_log_likelihood(const std::string &variable,
                                  const Parameters &parameters,
                                  const Data &data)
{
  arma::colvec y = data["y"];
  arma::mat gradient(1, 1);
  gradient(0, 0) = arma::sum(y - parameters["θ"][0]);
  return gradient;
}
